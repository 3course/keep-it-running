{
  "name": "keep-it-running",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/og.mjs",
    "sim": "tsc -p tsconfig.sim.json && node dist-sim/sim/headless.js",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
